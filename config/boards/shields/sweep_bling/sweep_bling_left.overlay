#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        /* Link ZMK pointing to the listener, not the raw device */
        zmk,pointing_device = &trackpoint_listener;
    };

    /* Frontend: Processes movement and sends HID reports */
    trackpoint_listener: input_listener {
        compatible = "zmk,input-listener";
        device = <&ps2>;
        xy-swap;
        scale-multiplier = <2>;
        scale-divisor = <3>;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <5>;
        map = <
            RC(4,0) RC(3,0) RC(2,0) RC(1,0) RC(0,0)   RC(0,5) RC(1,5) RC(2,5) RC(3,5) RC(4,5)
            RC(4,1) RC(3,1) RC(2,1) RC(1,1) RC(0,1)   RC(0,6) RC(1,6) RC(2,6) RC(3,6) RC(4,6)
            RC(4,2) RC(3,2) RC(2,2) RC(1,2) RC(0,2)   RC(0,7) RC(1,7) RC(2,7) RC(3,7) RC(4,7)
                    RC(1,3) RC(0,3)   RC(0,8) RC(1,8)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        row-gpios
            = <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 26 GPIO_ACTIVE_HIGH>
            , <&gpio0 27 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            ;
        col-gpios
            = <&gpio0 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

/* 1. Define the PIO State Machine for UART on GP2/GP3 */
&pio0 {
    status = "okay";

    pio_uart_default: pio_uart_default {
        /* Raw pin numbers for GP2 and GP3 on RP2040 */
        pinmux = <2>, <3>; 
    };
};

/* 2. Configure the PIO-UART Backend Bus */
trackpoint_bus: trackpoint_bus {
    compatible = "raspberrypi,pico-uart-pio";
    pinctrl-0 = <&pio_uart_default>;
    pinctrl-names = "default";
    status = "okay";

    /* 3. Define the PS/2 Device inside the PIO-UART bus */
    ps2: ps2 {
        compatible = "petejohanson,ps2-uart";
        status = "okay";
    };
};

&i2c0 {
    status = "disabled";
};