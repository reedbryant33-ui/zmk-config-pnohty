#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
        zmk,physical-layout = &matrix_physical_layout;
        zmk,kscan = &kscan0;
        zmk,pointing = &trackpoint;
    };

    /* PIO PS/2 Trackpoint Driver */
    trackpoint_device: ps2_device {
        compatible = "gpio-ps2-pio";
        status = "okay";
        label = "TRACKPOINT";
        scl-gpios = <&gpio0 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        sda-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        pio-device = <&pio0>;
        pio-sm = <0>;
    };

    /* PS/2 Mouse Input Listener (processes trackpoint events and sends HID reports) */
    trackpoint: zmk_input_mouse_ps2 {
        compatible = "zmk,input-mouse-ps2";
        ps2-device = <&trackpoint_device>;
        /* Sensitivity tuning - default is 128, range 0-255 */
        /* tp-sensitivity = <128>; */
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <5>;
        map = <
            RC(4,0) RC(3,0) RC(2,0) RC(1,0) RC(0,0)   RC(0,5) RC(1,5) RC(2,5) RC(3,5) RC(4,5)
            RC(4,1) RC(3,1) RC(2,1) RC(1,1) RC(0,1)   RC(0,6) RC(1,6) RC(2,6) RC(3,6) RC(4,6)
            RC(4,2) RC(3,2) RC(2,2) RC(1,2) RC(0,2)   RC(0,7) RC(1,7) RC(2,7) RC(3,7) RC(4,7)
                    RC(1,3) RC(0,3)   RC(0,8) RC(1,8)
        >;
    };

    matrix_physical_layout: matrix_physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Sweep Bling Left";
        transform = <&default_transform>;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        row-gpios
            = <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 26 GPIO_ACTIVE_HIGH>
            , <&gpio0 27 GPIO_ACTIVE_HIGH>
            , <&gpio0 28 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            ;
        col-gpios
            = <&gpio0 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 5  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

&pio0 {
    status = "okay";
};

&i2c0 {
    status = "disabled";
};

/* Enable the RP2040 USB controller */
&zephyr_udc0 {
    status = "okay";

    /* Create the virtual serial port */
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};
