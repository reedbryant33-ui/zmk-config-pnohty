; PS/2 TX PIO Program
; Based on Research & Implementation Strategy

.program ps2_tx
.side_set 2 opt ; Sideset used to control Clock (bit 1) and Data (bit 0) lines as outputs
                ; 0b11 = Both High (Idle)
                ; 0b01 = Clock Low, Data High
                ; 0b10 = Clock High, Data Low (etc)

; NOTE: PS/2 Host-to-Device Communication
; 1. Host pulls Clock low for >100us
; 2. Host pulls Data low
; 3. Host releases Clock
; 4. Device starts generating clock pulses to read data

; This simple TX program handles the "Host Request to Send" sequence:
; - Bring Clock Low
; - Wait
; - Bring Data Low
; - Release Clock
; The actual data transmission is clocked by the DEVICE, so we might need a more complex
; interaction or just use this to trigger the device to enter RX mode.

; However, for standard PS/2 sending (Host -> Device), the Host controls the bus initially.

; Standard "Host Request to Send" (Step 1 & 2):
    set pindirs, 3 side 0b11 ; Set both pins as outputs, initially High (Idle)
    
    ; 1. Pull Clock Low for >100us
    set pins, 2    side 0b01 [31] ; Clock Low (bit 1=0), Data High (bit 0=1). Delay.
    nop            side 0b01 [31] ; More delay... (need enough cycles for >100us)
    nop            side 0b01 [31]
    nop            side 0b01 [31] 
    
    ; 2. Pull Data Low, then release Clock
    set pins, 0    side 0b00      ; Data Low (bit 0=0), Clock Low (bit 1=0)
    set pins, 1    side 0b10      ; Release Clock (High), Keep Data Low (Start Bit)
    
    ; 3. Now the Device takes over clock generation. 
    ; We need to shift out data on the FALLING edge of the clock generated by the device.
    
    set x, 8             ; 8 data bits + 1 parity bit = 9 bits to send (Start bit already set low above)
    
loop_tx:
    wait 0 gpio 3        ; Wait for Device to pull Clock Low (Device acks bit)
    out pins, 1          ; Shift out 1 data bit to Data pin
    wait 1 gpio 3        ; Wait for Device to release Clock High
    jmp x--, loop_tx     ; Loop
    
    ; Stop bit (High)
    wait 0 gpio 3        ; Wait for Clock Low
    set pins, 1          ; Data High (Stop bit)
    wait 1 gpio 3        ; Wait for Clock High
    
    ; Ack bit (Device pulls Data Low) - we just wait for the clock cycle
    wait 0 gpio 3
    wait 1 gpio 3
    
    set pindirs, 0       ; Set pins back to inputs (Idle/Receive mode)
