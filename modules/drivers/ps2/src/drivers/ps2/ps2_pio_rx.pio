.program ps2_rx
.wrap_target
    wait 0 gpio 3        ; Wait for Clock Low (Start bit)
    in pins, 1           ; Sample Start Bit
    set x, 9             ; Loop for 10 more bits (8 data + 1 parity + 1 stop)
bit_loop:
    wait 1 gpio 3        ; Wait for Clock High
    wait 0 gpio 3 [2]    ; Wait for Clock Low + 2 cycles debounce
    in pins, 1           ; Sample bit
    jmp x--, bit_loop
    
    wait 1 gpio 3        ; Wait for Clock to go High (End of frame)
.wrap
